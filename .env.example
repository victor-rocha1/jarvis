# Chave de API do Google Gemini (Google AI Studio)
GEMINI_API_KEY="sua_chave_aqui"

# Modelo Gemini (Padrão: gemini-3.5-flash)
GEMINI_MODEL="gemini-3.5-flash"

# Configuração de Voz (edge-tts)
TTS_VOICE="pt-BR-AntonioNeural"
TTS_RATE="+0%"
TTS_VOLUME="+0%"
ENABLE_VOICE="true"

# Automação de Hardware - Bluetooth BLE (Fase 2)
GEONAV_MAC_ADDRESS="AA:BB:CC:DD:EE:FF"
